#!/usr/bin/env bash
# Telescope-style fzf picker over every pane running Claude Code, across all sessions.
# Usage: claude-picker [client]   (bound to prefix A, runs in a popup)

client=$1

if [[ $client == --list ]]; then
	now=$(date +%s)
	sep=$'\x1f'
	tmux list-panes -a -F "#{pane_id}$sep#{pane_current_command}$sep#{@claude}$sep#{session_name}:#{window_index}.#{pane_index}$sep#{window_name}$sep#{window_activity}$sep#{pane_current_path}" |
		while IFS=$sep read -r id cmd state target wname activity path; do
			# native installs show up as their version number (e.g. 2.1.281)
			[[ $cmd == claude || $cmd =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || continue
			[[ $wname == "$cmd" ]] && wname=${path##*/}
			case $state in
			waiting) rank=0 icon=$'\e[38;2;247;118;142m needs you' ;;
			done) rank=1 icon=$'\e[38;2;158;206;106m done     ' ;;
			working) rank=2 icon=$'\e[38;2;224;175;104m\xf3\xb0\x9a\xa9 working  ' ;;
			*) rank=3 icon=$'\e[38;2;86;95;137m idle     ' ;;
			esac
			age=$((now - activity))
			if ((age < 60)); then age="${age}s"
			elif ((age < 3600)); then age="$((age / 60))m"
			elif ((age < 86400)); then age="$((age / 3600))h"
			else age="$((age / 86400))d"; fi
			printf '%s\t%s\t%s\e[0m  \e[38;2;122;162;247m%-18s\e[0m \e[38;2;192;202;245m%-14s\e[0m \e[38;2;86;95;137m%4s  %s\e[0m\n' \
				"$rank" "$id" "$icon" "$target" "${wname:0:14}" "$age" "${path/#$HOME/~}"
		done | sort -t$'\t' -k1,1n | cut -f2-
	exit 0
fi

self=$(realpath "$0")
selected=$("$self" --list | fzf \
	--ansi --delimiter '\t' --with-nth 2 --no-sort --layout reverse \
	--prompt '  ' --pointer '▌' --marker '' \
	--header 'enter: go · ctrl-r: refresh · esc: close' \
	--border none --info inline-right \
	--preview 'tmux capture-pane -ep -t {1}' \
	--preview-window 'right,60%,border-left,follow,nowrap' \
	--bind "ctrl-r:reload('$self' --list)" \
	--color 'bg:-1,bg+:#292e42,fg:#a9b1d6,fg+:#c0caf5,hl:#ff9e64,hl+:#ff9e64' \
	--color 'prompt:#bb9af7,pointer:#bb9af7,info:#565f89,header:#565f89,border:#3b4261,gutter:-1' |
	cut -f1)

[[ -z $selected ]] && exit 0
[[ $client == /dev/* ]] || client=

tmux select-window -t "$selected" \; select-pane -t "$selected"
tmux switch-client ${client:+-c "$client"} -t "$selected"
